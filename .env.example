APP_NAME=Fitness
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_REGISTRATION_ENABLED=false
AUTH_PASSWORD_RESET_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=fitness_app
DB_USERNAME=fitness
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 本地開發帳號：php artisan db:seed 時在 APP_ENV=local 建立（已完成首次設定），帳密只填在 .env
DEV_ACCOUNT_NAME=
DEV_ACCOUNT_EMAIL=
DEV_ACCOUNT_PASSWORD=

# 第三方登入：啟用的 provider（逗號分隔），還需要對應 driver 的憑證設定齊全才會顯示
SOCIAL_LOGIN_PROVIDERS=google

# Google OAuth 用戶端（建立步驟見 packages/fitness/social-login-google/README.md）；沒填時不顯示 Google 登入
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# 照片分析：使用的 driver、每人每天上限（含失敗）、呼叫逾時秒數
FOOD_ANALYZER_DRIVER=gemini
FOOD_ANALYZER_DAILY_LIMIT=20
FOOD_ANALYZER_TIMEOUT=25

VITE_APP_NAME="${APP_NAME}"
